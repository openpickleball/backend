# Code owners for openpickleball/backend.
#
# GitHub requests a review from the owners of every path a pull request
# changes. The last matching rule wins, so the default comes first.
#
# Security-sensitive areas (see CLAUDE.md) get their own entries. When an
# app for score confirmation, organizer verification, duplicate detection,
# identity linking, or rating changes lands, or the match ledger app lands,
# add an entry for its directory here in the same pull request. List only
# paths that exist: a test checks every path below.

* @openpickleball/maintainers

# Account identity and login, the base for identity linking.
/apps/accounts/ @openpickleball/maintainers

# Audit log, append-only: the record of rating, match, and moderation changes.
/apps/audit/ @openpickleball/maintainers

# Public identifiers partners store forever; codes must resist enumeration.
/apps/public_ids/ @openpickleball/maintainers

# Player personal data, privacy settings, and the Player to Account link,
# the base for identity linking.
/apps/players/ @openpickleball/maintainers

# Organizer verification (a verified Organizer's submissions count as
# confirmed) and the club and organizer roles.
/apps/clubs/ @openpickleball/maintainers

# Partner Applications (OAuth clients), their approval, and Club
# Application Grants, which decide who may submit a club's matches.
/apps/partners/ @openpickleball/maintainers

# The match ledger, append-only (hard rule 3).
/apps/matches/ @openpickleball/maintainers

# Ratings and the engine adapter: rating changes (hard rule 8).
/apps/ratings/ @openpickleball/maintainers

# CI, the DCO check, and this file.
/.github/ @openpickleball/maintainers
