# Local development settings. Copy to .env (never commit .env).
# Values already set in the process environment win over this file.

# Production needs a long random key and DJANGO_DEBUG=False. Generate a key with:
# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
# Left empty here: with DEBUG on, a development-only key is used.
# Docker Compose also reads your .env and treats a $ in a value as a
# variable reference. Wrap a key that contains $ in single quotes, like
# DJANGO_SECRET_KEY='...'. Compose does not read variables inside single
# quotes, and the settings strip the quotes.
DJANGO_SECRET_KEY=
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# The database and cache URLs match the services in compose.yaml.
DATABASE_URL=postgres://open@localhost:5432/open
# REDIS_URL is the cache and the Celery broker. Leave CELERY_BROKER_URL,
# CELERY_BROKER_READ_URL, CELERY_BROKER_WRITE_URL, and CELERY_RESULT_BACKEND
# unset: settings refuse to start when any of them has a value.
# REDIS_URL takes redis://[USER:PASSWORD@]HOST:PORT/DB, or rediss:// for
# TLS (required by DigitalOcean Managed Caching), with no query string or
# fragment.
# Percent-encode any URL-reserved character in the password.
REDIS_URL=redis://localhost:6379/0
CSRF_TRUSTED_ORIGINS=
# Browser origins allowed to call the API, comma-separated, for example
# https://app.example.org,http://localhost:3000. Each is an exact origin:
# http or https, a host, and an optional port, with no path, trailing
# slash, or wildcard. Leave out :443 for https and :80 for http: browsers
# never send the default port, so such an entry is refused. Empty allows
# no origin. Only /api/ and /_allauth/ paths get CORS headers.
CORS_ALLOWED_ORIGINS=
# The web app's origin. Links in account emails (verify an address, reset
# a password) open pages there. Required, and an exact origin like a
# CORS_ALLOWED_ORIGINS entry: no path or trailing slash. It must be https
# when DJANGO_DEBUG is off. 8081 is the Expo web development server's port.
FRONTEND_URL=http://localhost:8081
# gunicorn only (gunicorn.conf.py): the port to listen on (default 8000)
# and the number of worker processes (default 2). gunicorn reads these two
# from the process environment only, for example the platform's
# environment or PORT=9000 uv run gunicorn. Setting them in .env does
# nothing. gunicorn parses WEB_CONCURRENCY itself before reading its
# config, so a blank or non-integer value stops startup with gunicorn's
# own error. Leave them unset for local development.
# PORT=8000
# WEB_CONCURRENCY=2
# Days a pending (unconfirmed) match waits before a daily task voids it, as
# a whole number from 1 to 36500, for example 30. Empty means pending matches
# never expire. A bad value stops startup.
MATCH_CONFIRMATION_EXPIRY_DAYS=
# Days a disputed match waits for a resolution, and days a possible
# duplicate flag stays open, before the daily task voids the match (ADR
# 0034). Whole numbers from 1 to 36500. Empty gives the defaults below; there
# is no value that turns either off. A bad value stops startup.
# MATCH_DISPUTE_EXPIRY_DAYS=30
# MATCH_DUPLICATE_HOLD_DAYS=14
# The current versions of the Terms of Service and the Privacy Policy on
# openpb.org, which sign-up requires accepting (ADR 0026). Whole numbers
# from 1. Empty means the versions in config/settings.py. A bad value
# stops startup.
TERMS_OF_SERVICE_VERSION=
PRIVACY_POLICY_VERSION=
# API throttle rates (ADR 0030), as whole numbers of requests from 1 to
# 1000000. Unset means the defaults shown. A bad value stops startup.
# CLIENT_IP_HEADER names the header the proxy sets to the client IP
# (do-connecting-ip on DigitalOcean App Platform). Never X-Forwarded-For
# or Forwarded, which a client can forge. Leave them unset unless a limit
# needs changing.
# API_ACCOUNT_THROTTLE_PER_MINUTE=120
# API_ACCOUNT_THROTTLE_PER_DAY=10000
# API_CLIENT_IP_THROTTLE_PER_MINUTE=60
# API_CLIENT_IP_THROTTLE_PER_DAY=3000
# CLIENT_IP_HEADER=do-connecting-ip
# Where a player's public profile lives: the rating lookup's
# profile_url is this followed by the player's OPEN Code. Optional. An
# absolute URL whose path ends in /, with no query or fragment, and https
# when DJANGO_DEBUG is off.
# OPEN_PUBLIC_PROFILE_URL=https://openpb.org/players/
# Email (ADR 0016). EMAIL_BACKEND is a Django email backend path. Empty
# with DJANGO_DEBUG on prints every message to the console. With
# DJANGO_DEBUG off it is required, and backends that print or keep
# messages are refused. Production uses Resend through django-anymail:
# EMAIL_BACKEND=anymail.backends.resend.EmailBackend with RESEND_API_KEY
# (required then). To use Amazon SES instead, see the Email section of
# config/settings.py: no code change, only a dependency and these values.
EMAIL_BACKEND=
RESEND_API_KEY=
# The sender of every message. Required with DJANGO_DEBUG off. Empty
# with DEBUG on means OPEN <noreply@localhost>. Its domain must be
# verified with the provider (production: mail.openpb.org, see
# docs/email.md).
DEFAULT_FROM_EMAIL=
