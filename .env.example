# Local development settings. Copy to .env (never commit .env).
# Values already set in the process environment win over this file.

# Production needs a long random key and DJANGO_DEBUG=False. Generate a key with:
# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
# Left empty here: with DEBUG on, a development-only key is used.
DJANGO_SECRET_KEY=
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# The database and cache URLs match the services in compose.yaml.
DATABASE_URL=postgres://open@localhost:5432/open
REDIS_URL=redis://localhost:6379/0
CSRF_TRUSTED_ORIGINS=
