# Local development settings. Copy to .env (never commit .env).
# Values already set in the process environment win over this file.

# Production needs a long random key and DJANGO_DEBUG=False. Generate a key with:
# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
# Left empty here: with DEBUG on, a development-only key is used.
# Docker Compose also reads your .env and treats a $ in a value as a
# variable reference. Wrap a key that contains $ in single quotes, like
# DJANGO_SECRET_KEY='...'. Compose does not read variables inside single
# quotes, and the settings strip the quotes.
DJANGO_SECRET_KEY=
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# The database and cache URLs match the services in compose.yaml.
DATABASE_URL=postgres://open@localhost:5432/open
# REDIS_URL is the cache and the Celery broker. Leave CELERY_BROKER_URL,
# CELERY_BROKER_READ_URL, CELERY_BROKER_WRITE_URL, and CELERY_RESULT_BACKEND
# unset: settings refuse to start when any of them has a value.
# REDIS_URL takes redis://[USER:PASSWORD@]HOST:PORT/DB, or rediss:// for
# TLS (required by DigitalOcean Managed Caching), with no query string or
# fragment.
# Percent-encode any URL-reserved character in the password.
REDIS_URL=redis://localhost:6379/0
CSRF_TRUSTED_ORIGINS=
